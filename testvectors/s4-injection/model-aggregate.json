{
  "format_version": 1,
  "spec": "S4",
  "function": "injection.model.aggregate",
  "description": "Pencere skorlarından detection üretimi (S4 §7.3).",
  "cases": [
    {
      "id": "en-yuksek-skor",
      "description": "raw_score en yüksek pencere skorudur; span o pencerenin aralığıdır.",
      "spec_refs": [
        "S4-MOD-001"
      ],
      "input": {
        "segment": 0,
        "model": {
          "id": "ornek-model",
          "version": "0.0.1",
          "threshold": 0.8,
          "calibrated": false
        },
        "windows": [
          {
            "span": [
              0,
              40
            ],
            "score": 0.12
          },
          {
            "span": [
              30,
              80
            ],
            "score": 0.91
          },
          {
            "span": [
              70,
              95
            ],
            "score": 0.4
          }
        ],
        "truncated": false
      },
      "expected": {
        "detections": [
          {
            "detector": "injection.model",
            "version": "0.0.1",
            "segment": 0,
            "span": [
              30,
              80
            ],
            "raw_score": 0.91,
            "calibrated": false,
            "threshold": 0.8,
            "model": "ornek-model",
            "truncated": false
          }
        ]
      },
      "match": "exact"
    },
