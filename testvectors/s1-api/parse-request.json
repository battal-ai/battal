      "spec_refs": [
        "S1-REQ-001",
        "S1-SEG-003"
      ],
      "input": {
        "request": {
          "api_version": "v1",
          "request_id": "r-asgari",
          "checkpoint": "input",
          "segments": [
            {
              "id": 0,
              "text": "Merhaba"
            }
          ]
        }
      },
      "expected": {
        "api_version": "v1",
        "request_id": "r-asgari",
