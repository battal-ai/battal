{
  "format_version": 1,
  "spec": "S5",
  "function": "bundle.hash",
  "description": "Kanonik bundle hash'i (S5 §3.3).",
  "cases": [
    {
      "id": "ornek-bundle-hash",
      "description": "Örnek bundle'ın hash'i sabittir.",
      "spec_refs": [
        "S5-BND-005"
      ],
      "input": {
        "bundle": {
          "bundle": {
            "name": "ornek",
            "version": "1.0.0"
          },
          "bindings": {
            "bindings": [
              {
                "id": "global",
                "policy": "default-tr",
                "match": {}
              },
              {
                "id": "finans",
                "policy": "strict-pii",
                "match": {
                  "team": "finans",
                  "checkpoint": [
                    "input",
                    "output"
                  ]
                },
                "selectable": [
                  "strict-pii",
                  "lenient"
                ]
              }
            ]
          },
          "policies": [
            {
              "id": "default-tr",
              "version": "1.0.0",
              "rules": [
                {
                  "id": "pii.mask_tckn",
                  "when": {
                    "detector": "pii.tckn",
                    "checksum_valid": true
                  },
                  "action": "mask"
                },
                {
                  "id": "pii.mask_email",
                  "when": {
                    "detector": "pii.email"
                  },
                  "action": "mask"
                },
                {
                  "id": "pi.block_untrusted",
                  "when": {
                    "all": [
                      {
                        "detector": "injection.model",
                        "above_threshold": true
                      },
                      {
                        "trust": "untrusted"
                      }
                    ]
                  },
                  "action": "block",
                  "checkpoints": [
                    "input"
                  ],
                  "rationale": {
                    "code": "PROMPT_INJECTION",
                    "message_tr": "İstek güvenlik politikası nedeniyle engellendi."
                  }
                }
              ]
            },
            {
              "id": "strict-pii",
              "version": "1.0.0",
              "rules": [
                {
                  "id": "strict.block_tckn",
                  "when": {
                    "detector": "pii.tckn",
                    "checksum_valid": true
                  },
                  "action": "block"
                }
              ]
            },
            {
              "id": "lenient",
              "version": "1.0.0",
              "rules": [
                {
                  "id": "lenient.allow_tckn",
                  "when": {
                    "detector": "pii.tckn"
                  },
                  "action": "allow"
                }
              ]
            }
          ]
        }
      },
      "expected": {
        "bundle_hash": "sha256:455f505dea46a31b31f82edcaa3a53947f20b1f72cad27c3e863ea1cd3961b46"
      }
    },
    {
      "id": "anahtar-sirasi-etkisiz",
      "description": "Anahtar sırası hash'i değiştirmez.",
      "spec_refs": [
        "S5-BND-005"
      ],
      "input": {
        "bundle": {
          "policies": [
            {
              "rules": [
                {
                  "action": "mask",
                  "when": {
                    "checksum_valid": true,
                    "detector": "pii.tckn"
                  },
                  "id": "pii.mask_tckn"
                },
                {
                  "action": "mask",
                  "when": {
                    "detector": "pii.email"
                  },
                  "id": "pii.mask_email"
                },
                {
                  "rationale": {
                    "message_tr": "İstek güvenlik politikası nedeniyle engellendi.",
                    "code": "PROMPT_INJECTION"
                  },
                  "checkpoints": [
                    "input"
                  ],
                  "action": "block",
                  "when": {
                    "all": [
                      {
                        "above_threshold": true,
                        "detector": "injection.model"
                      },
                      {
                        "trust": "untrusted"
                      }
                    ]
                  },
                  "id": "pi.block_untrusted"
                }
              ],
              "version": "1.0.0",
              "id": "default-tr"
            },
            {
              "rules": [
                {
                  "action": "block",
                  "when": {
                    "checksum_valid": true,
                    "detector": "pii.tckn"
                  },
                  "id": "strict.block_tckn"
                }
              ],
              "version": "1.0.0",
              "id": "strict-pii"
            },
            {
              "rules": [
                {
                  "action": "allow",
                  "when": {
                    "detector": "pii.tckn"
                  },
                  "id": "lenient.allow_tckn"
                }
              ],
              "version": "1.0.0",
              "id": "lenient"
            }
          ],
          "bindings": {
            "bindings": [
              {
                "match": {},
                "policy": "default-tr",
                "id": "global"
              },
              {
                "selectable": [
                  "strict-pii",
                  "lenient"
                ],
                "match": {
                  "checkpoint": [
                    "input",
                    "output"
                  ],
                  "team": "finans"
                },
                "policy": "strict-pii",
                "id": "finans"
              }
            ]
          },
          "bundle": {
            "version": "1.0.0",
            "name": "ornek"
          }
        }
      },
      "expected": {
        "bundle_hash": "sha256:455f505dea46a31b31f82edcaa3a53947f20b1f72cad27c3e863ea1cd3961b46"
      }
    },
