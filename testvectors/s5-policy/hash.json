    {
      "id": "tam-sayi-ondalik-esit",
      "description": "JCS'ye göre 1 ile 1.0 aynı biçimde yazılır; hash değişmez.",
      "spec_refs": [
        "S5-BND-005"
      ],
      "input": {
        "bundle": {
          "bundle": {
            "name": "ornek",
            "version": "1.0.0"
          },
          "bindings": {
            "bindings": [
              {
                "id": "global",
                "policy": "p",
                "match": {}
              }
            ]
          },
          "policies": [
            {
              "id": "p",
              "version": "1.0.0",
              "rules": [
                {
                  "id": "r",
                  "when": {
                    "detector": "x",
                    "min_score": 1.0
                  },
                  "action": "block"
                }
              ]
            }
          ]
        }
      },
      "expected": {
