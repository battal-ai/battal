{
  "format_version": 1,
  "spec": "S5",
  "function": "policy.evaluate",
  "description": "Degraded karar ve fail mode (S5 §7.5).",
  "cases": [
    {
      "id": "detector-arizasi-degraded",
      "description": "Bir detector çalışmadıysa karar kalan detection'larla verilir ve degraded true olur.",
      "spec_refs": [
        "S5-FLT-001",
        "S1-EVAL-003"
      ],
      "input": {
        "bundle": {
          "bundle": {
            "name": "ornek",
            "version": "1.0.0"
          },
          "bindings": {
            "bindings": [
              {
                "id": "global",
                "policy": "default-tr",
                "match": {}
              },
              {
                "id": "finans",
                "policy": "strict-pii",
                "match": {
                  "team": "finans",
                  "checkpoint": [
                    "input",
                    "output"
                  ]
                },
                "selectable": [
                  "strict-pii",
                  "lenient"
                ]
              }
            ]
          },
          "policies": [
            {
              "id": "default-tr",
              "version": "1.0.0",
              "rules": [
                {
                  "id": "pii.mask_tckn",
                  "when": {
                    "detector": "pii.tckn",
                    "checksum_valid": true
                  },
                  "action": "mask"
                },
                {
                  "id": "pii.mask_email",
                  "when": {
                    "detector": "pii.email"
                  },
                  "action": "mask"
                },
                {
                  "id": "pi.block_untrusted",
                  "when": {
                    "all": [
                      {
                        "detector": "injection.model",
                        "above_threshold": true
                      },
                      {
                        "trust": "untrusted"
                      }
                    ]
                  },
                  "action": "block",
                  "checkpoints": [
                    "input"
                  ],
                  "rationale": {
                    "code": "PROMPT_INJECTION",
                    "message_tr": "İstek güvenlik politikası nedeniyle engellendi."
                  }
                }
              ]
            },
            {
              "id": "strict-pii",
              "version": "1.0.0",
              "rules": [
                {
                  "id": "strict.block_tckn",
                  "when": {
                    "detector": "pii.tckn",
                    "checksum_valid": true
                  },
                  "action": "block"
                }
              ]
            },
            {
              "id": "lenient",
              "version": "1.0.0",
              "rules": [
                {
                  "id": "lenient.allow_tckn",
                  "when": {
                    "detector": "pii.tckn"
                  },
                  "action": "allow"
                }
              ]
            }
          ]
        },
        "request": {
          "api_version": "v1",
          "request_id": "req-1",
          "checkpoint": "input",
          "segments": [
            {
              "id": 0,
              "text": "TC'm 10000000146"
            }
          ]
        },
        "detections": [
          {
            "detector": "pii.tckn",
            "version": "0.1.0",
            "segment": 0,
            "span": [
              5,
              16
            ],
            "checksum_valid": true,
            "context_hit": true
          }
        ],
        "detector_failures": [
          "injection.model"
        ]
      },
      "expected": {
        "decision": {
          "action": "mask",
          "rule_id": "pii.mask_tckn",
          "degraded": true
        }
      }
    },
