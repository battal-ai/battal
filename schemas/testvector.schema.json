{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://battal-ai.github.io/battal/schemas/testvector.schema.json",
  "title": "Battal test vektörü suite'i",
  "description": "S0: Spec ve test vektörü formatı, format_version 1.",
  "type": "object",
  "required": ["format_version", "spec", "function", "cases"],
  "additionalProperties": false,
  "properties": {
    "format_version": {"const": 1},
    "spec": {"type": "string", "pattern": "^S[0-9]+$"},
    "function": {"type": "string", "pattern": "^[a-z][a-z0-9_]*(\\.[a-z][a-z0-9_]*)*$"},
    "description": {"type": "string", "minLength": 1},
    "cases": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/case"}}
  },
  "$defs": {
    "case": {
      "type": "object",
      "required": ["id", "description", "spec_refs", "input"],
      "additionalProperties": false,
      "properties": {
        "id": {"type": "string", "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"},
        "description": {"type": "string", "minLength": 1},
        "spec_refs": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"type": "string", "pattern": "^S[0-9]+-[A-Z]+-[0-9]{3}$"}
        },
        "tags": {
          "type": "array",
          "uniqueItems": true,
          "items": {"type": "string", "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"}
        },
        "input": {"type": "object"},
        "expected": true,
        "expected_error": {
          "type": "object",
          "required": ["code"],
          "additionalProperties": false,
          "properties": {"code": {"type": "string", "pattern": "^[A-Z][A-Z0-9_]*$"}}
        },
        "match": {"enum": ["subset", "exact"], "default": "subset"}
      },
      "oneOf": [
        {"required": ["expected"], "not": {"required": ["expected_error"]}},
        {"required": ["expected_error"], "not": {"required": ["expected"]}}
      ]
    }
  }
}
