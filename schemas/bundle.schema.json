{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://battal-ai.github.io/battal/schemas/bundle.schema.json",
  "title": "bundle.yaml",
  "description": "S5: Policy, binding ve bundle.",
  "type": "object",
  "required": ["name", "version"],
  "additionalProperties": false,
  "properties": {
    "name": {"type": "string", "pattern": "^[a-z0-9]+([._-][a-z0-9]+)*$", "maxLength": 128},
    "version": {"$ref": "#/$defs/semver"},
    "fail_modes": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "input": {"$ref": "#/$defs/fail_mode"},
        "output": {"$ref": "#/$defs/fail_mode"},
        "retrieval": {"$ref": "#/$defs/fail_mode"},
        "tool_call": {"$ref": "#/$defs/fail_mode"},
        "tool_result": {"$ref": "#/$defs/fail_mode"},
        "memory_write": {"$ref": "#/$defs/fail_mode"}
      }
    }
  },
  "$defs": {
    "fail_mode": {"enum": ["open", "closed"]},
    "semver": {"type": "string", "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)(-[0-9A-Za-z.-]+)?$"}
  }
}
