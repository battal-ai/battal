{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://battal-ai.github.io/battal/schemas/policy.schema.json",
  "title": "Policy dosyası",
  "description": "S5: Policy, binding ve bundle.",
  "type": "object",
  "required": [
    "id",
    "version",
    "rules"
  ],
  "additionalProperties": false,
  "properties": {
    "id": {
      "$ref": "#/$defs/id"
    },
    "version": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)(-[0-9A-Za-z.-]+)?$"
    },
    "description": {
      "type": "string"
    },
    "rules": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/rule"
      }
    }
  },
  "$defs": {
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9]+([._-][a-z0-9]+)*$",
      "maxLength": 128
    },
    "rule": {
      "type": "object",
      "required": [
        "id",
        "when",
        "action"
      ],
      "additionalProperties": false,
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "description": {
          "type": "string"
        },
        "checkpoints": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "enum": [
              "input",
              "output",
              "retrieval",
              "tool_call",
              "tool_result",
              "memory_write"
            ]
          }
        },
        "when": {
          "$ref": "#/$defs/condition"
        },
        "action": {
          "enum": [
            "allow",
            "mask",
            "block",
            "ask"
          ]
        },
        "rationale": {
          "type": "object",
          "required": [
            "code",
            "message_tr"
          ],
          "additionalProperties": false,
          "properties": {
            "code": {
              "type": "string",
              "pattern": "^[A-Z][A-Z0-9_]*$"
            },
            "message_tr": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        "placeholder": {
          "type": "string",
          "minLength": 1
        }
      },
      "if": {
        "properties": {
          "action": {
            "not": {
              "const": "mask"
            }
          }
        }
      },
      "then": {
        "not": {
          "required": [
            "placeholder"
          ]
        }
      }
    },
    "condition": {
      "oneOf": [
        {
          "type": "object",
          "required": [
            "all"
          ],
          "additionalProperties": false,
          "properties": {
            "all": {
              "type": "array",
              "minItems": 1,
              "items": {
                "$ref": "#/$defs/condition"
              }
            }
          }
        },
        {
          "type": "object",
          "required": [
            "any"
          ],
          "additionalProperties": false,
          "properties": {
            "any": {
              "type": "array",
              "minItems": 1,
              "items": {
                "$ref": "#/$defs/condition"
              }
            }
          }
        },
        {
          "type": "object",
          "required": [
            "not"
          ],
          "additionalProperties": false,
          "properties": {
            "not": {
              "$ref": "#/$defs/condition"
            }
          }
        },
        {
          "$ref": "#/$defs/detection_condition"
        },
        {
          "$ref": "#/$defs/segment_condition"
        },
        {
          "$ref": "#/$defs/signal_condition"
        },
        {
          "$ref": "#/$defs/unavailable_condition"
        }
      ]
    },
    "detection_condition": {
      "type": "object",
      "required": [
        "detector"
      ],
      "additionalProperties": false,
      "properties": {
        "detector": {
          "type": "string",
          "pattern": "^[a-z0-9*?]+([._-][a-z0-9*?]+)*$"
        },
        "checksum_valid": {
          "type": "boolean"
        },
        "context_hit": {
          "type": "boolean"
        },
        "min_score": {
          "type": "number"
        },
        "above_threshold": {
          "const": true
        },
        "signature": {
          "type": "string",
          "minLength": 1,
          "pattern": "^[a-z0-9*?]+([._-][a-z0-9*?]+)*$"
        },
        "truncated": {
          "type": "boolean"
        }
      }
    },
    "segment_condition": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": false,
      "properties": {
        "trust": {
          "$ref": "#/$defs/enum_or_list",
          "$comment": "trusted | untrusted"
        },
        "source": {
          "$ref": "#/$defs/enum_or_list"
        },
        "role": {
          "$ref": "#/$defs/enum_or_list"
        }
      }
    },
    "signal_condition": {
      "type": "object",
      "required": [
        "signal"
      ],
      "additionalProperties": false,
      "properties": {
        "signal": {
          "type": "string",
          "pattern": "^[a-z0-9]+([._-][a-z0-9]+)*$"
        },
        "min_count": {
          "type": "integer",
          "minimum": 1,
          "default": 1
        }
      }
    },
    "enum_or_list": {
      "oneOf": [
        {
          "type": "string",
          "minLength": 1
        },
        {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      ]
    },
    "unavailable_condition": {
      "type": "object",
      "required": [
        "detector_unavailable"
      ],
      "additionalProperties": false,
      "properties": {
        "detector_unavailable": {
          "type": "string",
          "pattern": "^[a-z0-9*?]+([._-][a-z0-9*?]+)*$"
        }
      }
    }
  }
}
