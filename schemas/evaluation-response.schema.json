{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://battal-ai.github.io/battal/schemas/evaluation-response.schema.json",
  "title": "EvaluationResponse",
  "description": "S1: Evaluation API sözleşmesi, api_version v1. İstemciler bilinmeyen alanları yok saymalıdır; şema yalnızca Battal'ın ürettiği yanıtı doğrular.",
  "type": "object",
  "required": ["api_version", "request_id", "decision", "detections", "transforms"],
  "additionalProperties": false,
  "properties": {
    "api_version": {"const": "v1"},
    "request_id": {"type": "string", "pattern": "^[A-Za-z0-9._:-]{1,128}$"},
    "decision": {
      "type": "object",
      "required": ["action", "rule_id", "policy", "bundle_hash", "matched_bindings", "decided_by", "fail_mode", "degraded"],
      "additionalProperties": false,
      "properties": {
        "action": {"enum": ["allow", "mask", "block", "ask"]},
        "rule_id": {"type": ["string", "null"], "minLength": 1},
        "policy": {
          "type": "object",
          "required": ["id", "version"],
          "additionalProperties": false,
          "properties": {"id": {"type": "string", "minLength": 1}, "version": {"type": "string", "minLength": 1}}
        },
        "bundle_hash": {"type": "string", "minLength": 1},
        "matched_bindings": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
        "decided_by": {
          "type": "object",
          "required": ["kind", "binding"],
          "additionalProperties": false,
          "properties": {
            "kind": {"enum": ["rule", "default", "fail_mode"]},
            "binding": {"type": ["string", "null"], "minLength": 1}
          }
        },
        "fail_mode": {"enum": ["open", "closed"]},
        "degraded": {"type": "boolean"}
      }
    },
    "detections": {"type": "array", "items": {"$ref": "#/$defs/detection"}},
    "transforms": {"type": "array", "items": {"$ref": "#/$defs/transform"}},
    "rationale": {
      "type": "object",
      "required": ["code", "message_tr"],
      "additionalProperties": false,
      "properties": {
        "code": {"type": "string", "pattern": "^[A-Z][A-Z0-9_]*$"},
        "message_tr": {"type": "string", "minLength": 1}
      }
    },
    "timing_ms": {"type": "object", "additionalProperties": {"type": "number", "minimum": 0}}
  },
  "$defs": {
    "span": {
      "type": "array",
      "prefixItems": [{"type": "integer", "minimum": 0}, {"type": "integer", "minimum": 0}],
      "minItems": 2,
      "maxItems": 2
    },
    "detection": {
      "type": "object",
      "required": ["detector", "version", "segment", "span"],
      "properties": {
        "detector": {"type": "string", "minLength": 1},
        "version": {"type": "string", "minLength": 1},
        "segment": {"type": "integer", "minimum": 0},
        "span": {"$ref": "#/$defs/span"},
        "raw_score": {"type": "number"},
        "calibrated": {"type": "boolean"},
        "threshold": {"type": "number"},
        "checksum_valid": {"type": "boolean"},
        "context_hit": {"type": "boolean"}
      },
      "not": {
        "anyOf": [
          {"required": ["text"]},
          {"required": ["value"]},
          {"required": ["match"]},
          {"required": ["excerpt"]}
        ]
      },
      "dependentRequired": {"raw_score": ["calibrated"]}
    },
    "transform": {
      "type": "object",
      "required": ["segment", "text", "edits"],
      "additionalProperties": false,
      "properties": {
        "segment": {"type": "integer", "minimum": 0},
        "text": {"type": "string"},
        "edits": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": ["span", "replacement"],
            "additionalProperties": false,
            "properties": {"span": {"$ref": "#/$defs/span"}, "replacement": {"type": "string"}}
          }
        }
      }
    }
  }
}
